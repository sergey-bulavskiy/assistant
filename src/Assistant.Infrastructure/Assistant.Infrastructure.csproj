<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Anthropic" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Telegram.Bot" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Assistant.Application/Assistant.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Role prompt sources live in the repo-root roles/ folder and are embedded as
         "roles/<dir>/<file>". RecursiveDir ends with '\' on Windows; RolePrompts normalizes it. -->
    <EmbeddedResource Include="../../roles/**/*.md" LogicalName="roles/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Fail the build (also inside Docker) when the role prompts are not where the item above looks. -->
  <Target Name="EnsureRolePromptsPresent" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)../../roles/health/prompt.md') Or !Exists('$(MSBuildThisFileDirectory)../../roles/health/extract.md')"
           Text="roles/health/prompt.md or roles/health/extract.md is missing. Role prompts are embedded from the repo-root roles/ folder; the Docker build must copy it." />
  </Target>

</Project>
