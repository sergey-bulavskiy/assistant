TELEGRAM_MANAGER_BOT_TOKEN=paste-your-manager-bot-token-here
# Base64-encoded 32 random bytes, e.g.: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=paste-a-base64-32-byte-key-here
# Letters and digits only — this value is interpolated directly into a Postgres connection string
# in docker-compose.yml, so punctuation (":", "@", "/", etc.) can break parsing.
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assistant
IMAGE_TAG=latest

# General assistant (role "general") LLM configuration. Leave LLM_MODELS and CLAUDE_CODE_OAUTH_TOKEN
# empty/unset (the default here) and the assistant replies "not configured" instead of calling a
# model; nothing here is required for the rest of the bots to work. Set both to turn it on -- see
# README "Set up the General assistant".
# Comma-separated provider:model entries tried in order, e.g. claude-cli:sonnet,claude-cli:haiku
LLM_MODELS=
# Every LLM_* limit below already has this same default baked into deploy/docker-compose.yml, so an
# .env that only sets LLM_MODELS and CLAUDE_CODE_OAUTH_TOKEN still gets a working LLM; uncomment and
# change a value here only if you want something other than the default.
# Max LLM calls per minute per family
#LLM_CALLS_PER_MINUTE=10
# Max LLM calls per UTC day per family
#LLM_CALLS_PER_DAY=200
# Max prior messages (both directions) sent to the model as context
#LLM_MAX_CONTEXT_MESSAGES=30
# Max total characters of context + current message sent to the model
#LLM_MAX_INPUT_CHARS=40000
# Max tokens the model may generate in one reply
#LLM_MAX_OUTPUT_TOKENS=4000
# Seconds before an in-flight model call is killed
#LLM_CALL_TIMEOUT_SECONDS=120
# Max LLM calls in flight at once across the whole process
#LLM_MAX_CONCURRENT_CALLS=2
# Minutes a model stays marked unavailable after a limit error with no reset time given
#LLM_MODEL_COOLDOWN_MINUTES=30
# Claude Code CLI auth token, generated with: claude setup-token (requires a Claude subscription)
CLAUDE_CODE_OAUTH_TOKEN=
# Pinned Claude Code CLI version, installed at container startup into a dedicated volume (the CLI is
# proprietary and never ships inside this public image). Leave unset to use this deploy's reviewed
# default.
CLAUDE_CLI_VERSION=2.1.285
